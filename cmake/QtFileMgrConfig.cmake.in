@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt@QTFILEMGR_QT_MAJOR_FOUND@ @QTFILEMGR_QT_MIN_VERSION@
    COMPONENTS Core Gui Widgets)
if(@QTFILEMGR_WITH_SSH@ AND NOT @BUILD_SHARED_LIBS@)
    find_dependency(PkgConfig)
    pkg_check_modules(LIBSSH REQUIRED IMPORTED_TARGET libssh)
endif()
set(QtFileMgr_WITH_SSH @QTFILEMGR_WITH_SSH@)
set(QtFileMgr_QT_MAJOR @QTFILEMGR_QT_MAJOR_FOUND@)
include("${CMAKE_CURRENT_LIST_DIR}/QtFileMgrTargets.cmake")
check_required_components(QtFileMgr)
